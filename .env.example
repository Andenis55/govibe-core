APP_NAME=govibe-core
NODE_ENV=development
# APP_VERSION=0.1.0
# APP_COMMIT=unknown
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/govibe
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

PAYSTACK_SECRET_KEY=sk_test_f0b02756ee63c5ffed1afdbf91bccfe85bd3c142
# PAYSTACK_BASE_URL=https://api.paystack.co
MTN_MOMO_API_KEY=replace-with-momo-api-key
MTN_MOMO_API_SECRET=replace-with-momo-api-secret
MTN_MOMO_SUBSCRIPTION_KEY=replace-with-momo-subscription-key
MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=replace-with-momo-collection-subscription-key
# MTN_MOMO_API_USER=replace-with-momo-api-user
# MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# PAYMENT_PROVIDER_TIMEOUT_MS=10000
# MTN_MOMO_WEBHOOK_SECRET=replace-with-momo-webhook-secret

QR_HMAC_ACTIVE_KID=v1
QR_HMAC_ACTIVE_SECRET=replace-with-32-char-qr-secret

API_BASE_URL=http://localhost:3000

# Optional
# SENTRY_DSN=
# PILOT_CHECKOUT_ENABLED=true
# PILOT_PAYMENTS_ENABLED=true
# PILOT_ADMISSIONS_ENABLED=true
# PILOT_ALLOWED_PAYMENT_PROVIDERS=paystack
# PILOT_ALLOWED_CURRENCIES=GHS
# PILOT_ALLOWED_ORGANIZER_IDS=00000000-0000-4000-8000-000000000001
# PILOT_ALLOWED_EVENT_IDS=00000000-0000-4000-8000-000000000002
# PILOT_ALLOWED_GATE_IDS=00000000-0000-4000-8000-000000000003
# QR_HMAC_SECRET_v0=replace-with-previous-rotated-secret
# QR_HMAC_SECRET_v1_PREVIOUS=replace-with-grace-verification-secret
# QR_ED25519_PUBLIC_KEY_v1=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----

# Payment smoke validation inputs
# PAYMENT_SMOKE_PROVIDERS=paystack
PAYMENT_SMOKE_PAYSTACK_EMAIL=test-buyer@example.com
PAYMENT_SMOKE_PAYSTACK_AMOUNT_MINOR=5000
PAYMENT_SMOKE_PAYSTACK_CURRENCY=NGN
# PAYMENT_SMOKE_PAYSTACK_CALLBACK_URL=http://localhost:3000/api/payments/paystack/callback

PAYMENT_SMOKE_MOMO_PHONE=256700000000
PAYMENT_SMOKE_MOMO_CURRENCY=UGX
PAYMENT_SMOKE_MOMO_AMOUNT_MINOR=500

# Required only when intentionally testing live Paystack keys or production MoMo.
# PAYMENT_SMOKE_ALLOW_LIVE=true

